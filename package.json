{
  "name": "domios-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "dev:site": "vite --config vite.site.config.ts",
    "build:site": "tsc -b && vite build --config vite.site.config.ts",
    "preview:site": "vite preview --config vite.site.config.ts",
    "shots": "node site/scripts/capture-shots.mjs",
    "dev:admin": "vite --config vite.admin.config.ts",
    "build:admin": "tsc -b && vite build --config vite.admin.config.ts",
    "dev:demo": "vite --mode demo --port 5175",
    "build:demo": "tsc -b && vite build --mode demo --outDir dist-demo",
    "preview:demo": "vite preview --mode demo --outDir dist-demo --port 5175"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/libre-caslon-display": "^5.3.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^5.1.1",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.75.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.1.1"
  }
}
